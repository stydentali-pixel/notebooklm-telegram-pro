# Telegram
TELEGRAM_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=change-this-long-random-secret
ADMIN_IDS=224659571

# Public URL after Railway deploy
BASE_URL=https://your-app.up.railway.app

# NotebookLM session. Put the one-line JSON from scripts/one_line_auth.py here.
NOTEBOOKLM_AUTH_JSON=
NOTEBOOKLM_HL=ar
NOTEBOOKLM_PROFILE=default

# App behavior
APP_NAME=NotebookLM Telegram Pro
DATA_DIR=/app/data
DOWNLOAD_DIR=/app/downloads
UPLOAD_DIR=/app/uploads
JOB_TIMEOUT_SECONDS=900
SOURCE_TIMEOUT_SECONDS=240
AUTO_DELETE_NOTEBOOKS=false
MAX_TELEGRAM_FILE_MB=45
