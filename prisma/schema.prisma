generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  FAMILY
  USER
  BLOCKED
}

enum AiProviderName {
  OpenRouter
  Gemini
  Groq
}

model BotUser {
  id             String      @id @default(cuid())
  telegramId     String      @unique
  username       String?
  firstName      String?
  lastName       String?
  role           UserRole    @default(USER)
  isAllowed      Boolean     @default(false)
  currentProvider AiProviderName?
  currentModel   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       AiMessage[]

  @@index([role])
  @@index([isAllowed])
}

model AiMessage {
  id          String         @id @default(cuid())
  telegramId  String
  userId      String?
  provider    AiProviderName
  model       String
  prompt      String
  response    String?
  status      String         @default("OK")
  error       String?
  tokens      Int?
  createdAt   DateTime       @default(now())
  user        BotUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([telegramId])
  @@index([createdAt])
  @@index([provider])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
